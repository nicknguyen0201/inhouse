# The SEC requires a User-Agent with real contact details and blocks requests
# without one. https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name your@email.com"

# Where raw filings and manifests go. An s3:// URI uses boto3 credentials from
# the usual chain; anything else is treated as a local directory.
STORAGE_URI=./data
# STORAGE_URI=s3://your-bucket

# Requests per second to SEC. Their published ceiling is 10; staying under it
# costs a few seconds and avoids a ten-minute block.
SEC_RATE_LIMIT=8
SEC_MAX_CONCURRENCY=6
